    "version": "0.2.0",
    "configurations": [
        {
            "name": "Install test",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "--config-name=kubefirst-test3",
                "k3d",
                 "create",
                  "--github-user",
                  "mwoodpatrick",
                  "--git-provider",
                  "github",
                  "--gitops-template-url",
                  "https://github.com/mwoodpatrick/gitops-template.git",
                  "--gitops-template-branch",
                  "mlwp-dev"

            ]
        },
        {
            "name": "Delete test",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "--config-name=kubefirst-test3",
                "k3d",
                 "delete"

            ]
        },
        {
            "name": "My K3d Debug Config",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "--config-name=mykubefirstconfig",
                "k3d",
                 "create",
                  "--cluster-name",
                  "kubefirst_test3",
                  "--github-user",
                  "mwoodpatrick",
                  "--git-provider",
                  "github",
                  "--gitops-repository-name",
                  "gitops_test",
                  "--metaphor-repository-name",
                  "metaphor_test"
            ]
        }
    ]
}
