{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Create test",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "k3d",
                "create",
                "--github-user",
                "mwoodpatrick",
                "--git-provider",
                "github",
                "--gitops-template-url",
                "https://github.com/mwoodpatrick/gitops-template.git",
                "--gitops-template-branch",
                "mlwp-dev"
            ]
        },
        {
            "name": "Destroy test",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "--debug",
                "k3d",
                "destroy"
            ]
        },
        {
            "name": "Connect to server",
            "type": "go",
            "debugAdapter": "dlv-dap",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}",
            "port": 2345,
            // "port": 60674,
            "host": "127.0.0.1"
        },
        {
            "name": "My K3d Debug Config",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": [
                "--config-name=mykubefirstconfig",
                "k3d",
                "create",
                "--cluster-name",
                "kubefirst_test3",
                "--github-user",
                "mwoodpatrick",
                "--git-provider",
                "github",
                "--gitops-repository-name",
                "gitops_test",
                "--metaphor-repository-name",
                "metaphor_test"
            ]
        }
    ]
}